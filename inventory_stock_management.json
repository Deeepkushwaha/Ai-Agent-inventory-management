    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  const p = item.json;\n\n  const currentStock = Number(p.current_stock);\n  const reorderLevel = Number(p.reorder_level);\n  const unitPrice = Number(p.unit_price);\n\n  return {\n    json: {\n      Product_ID: p.product_id,\n      product_name: p.product_name,\n      current_stock: currentStock,\n      reorder_level: reorderLevel,\n      unit_price: unitPrice,\n      units_needed: Math.max(0, reorderLevel - currentStock),\n      status: \"Low Stock\",\n      estimated_cost: Math.max(0, reorderLevel - currentStock) * unitPrice\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
